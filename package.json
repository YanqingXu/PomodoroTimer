{
  "name": "pomodoro-timer",
  "version": "1.0.0",
  "description": "一个适用于 Windows 10 的番茄时钟应用",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node tests/timer-background.test.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --dir",
    "package": "electron-packager . Pomodoro-Timer --platform=win32 --arch=x64 --out=dist --overwrite --icon=assets/icon.ico --ignore=\"^/dist\" --ignore=\"^/\\.git\""
  },
  "author": "Pomodoro Timer",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-packager": "^17.1.2"
  },
  "dependencies": {
    "electron-log": "^5.0.0"
  }
}
